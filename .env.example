# Optional settings. Copy to .env and run start.bat (or `docker compose up -d`) again.

# ---- Claude ----
# Model for the game master: sonnet (faster, uses less of your plan) or opus. Empty = Claude Code default.
CLAUDE_MODEL=

# Not needed if you connect your Claude account in the web app.
# Alternative: paste a token from `claude setup-token` here.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- ChatGPT (Codex) ----
# Model for the game master, as accepted by `codex -m`. Empty = Codex default.
CODEX_MODEL=

# Not needed if you connect your ChatGPT account in the web app.
# Alternative: an OpenAI API key (billed per use, not through a ChatGPT plan).
CODEX_API_KEY=
